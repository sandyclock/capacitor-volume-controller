{
  "compilerOptions": {
    "module": "esnext",
    "target": "es2017",
    "moduleResolution": "node",
    "lib": ["es2017", "dom", "dom.iterable", "es6"],
    "declaration": true,
    "outDir": "./dist/esm",
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "experimentalDecorators": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  // ⚠️ PRE-EXISTING defect: `__tests__` was compiled into dist/esm, and package.json
  // `files` ships `dist/`, so the published tarball carried the test suite. Tests are
  // also re-discovered from dist on the next jest run, which is why two phantom suites
  // failed. Excluded from the build; jest still runs them from src/.
  "exclude": ["node_modules", "dist", "src/**/__tests__/**", "src/**/*.test.ts", "src/**/*.spec.ts"]
}